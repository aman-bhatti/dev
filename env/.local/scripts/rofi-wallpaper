#!/usr/bin/env bash

WALLPAPER_DIR="$HOME/Pictures/wallpapers"

# Get all image files
mapfile -t wallpapers < <(find "$WALLPAPER_DIR" -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" \) | sort)

# Build rofi-compatible list: label (basename) + icon (full path)
choices=""
for wp in "${wallpapers[@]}"; do
    filename=$(basename "$wp")
    choices+="$filename\x00icon\x1f$wp\x1finfo\x1f$wp\n"
done

# Use rofi to select (but return the full path via 'info' key)
selected=$(echo -e "$choices" | rofi -dmenu \
    -markup-rows \
    -format i \
    -theme /home/aman/.config/rofi/themes/wallpaper.rasi \
    -p "🖼️ Choose Wallpaper")

# If nothing selected, exit
[[ -z "$selected" ]] && exit

# Convert index to actual wallpaper path
selected_path="${wallpapers[$selected]}"

# Preload and set wallpaper
hyprctl hyprpaper preload "$selected_path"
for MON in $(hyprctl monitors | grep "Monitor" | awk '{print $2}'); do
    hyprctl hyprpaper wallpaper "$MON,$selected_path"
done

